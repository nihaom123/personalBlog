---
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "@/config";
import { getEnabledFriends } from "@/config/friendsConfig";

const friends = getEnabledFriends();

const siteCards = [
	{
		title: "博客",
		desc: "记录生活里的碎碎念",
		href: "/blog/",
		icon: "material-symbols:article",
	},
	{
		title: "动态",
		desc: "随手发点小碎片",
		href: "/dynamic/",
		icon: "material-symbols:forum-rounded",
	},
	{
		title: "相册",
		desc: "收集生活的瞬间",
		href: "/gallery/",
		icon: "material-symbols:photo-library",
	},
	{
		title: "归档",
		desc: "按时间回顾所有文章",
		href: "/archive/",
		icon: "material-symbols:archive",
	},
];

const projectCards = [
	{
		title: "项目展示",
		desc: "做过的一些小东西",
		href: "/projects/",
		icon: "material-symbols:rocket-launch",
	},
	{
		title: "书签导航",
		desc: "常用网站收藏夹",
		href: "/booknav/",
		icon: "material-symbols:bookmarks",
	},
	{
		title: "关于我",
		desc: "简单认识一下",
		href: "/about/",
		icon: "material-symbols:person",
	},
	{
		title: "友链",
		desc: "朋友们的站点",
		href: "/friends/",
		icon: "material-symbols:link-2-rounded",
	},
	{
		title: "留言板",
		desc: "有话就写在这里",
		href: "/guestbook/",
		icon: "material-symbols:chat",
	},
];

const skills = [
	{ name: "HTML5", icon: "fa7-brands:html5", color: "#e34f26" },
	{ name: "CSS3", icon: "fa7-brands:css3-alt", color: "#2965f1" },
	{ name: "JavaScript", icon: "fa7-brands:js", color: "#f7df1e" },
	{ name: "Node.js", icon: "fa7-brands:node-js", color: "#5fa04e" },
	{ name: "Python", icon: "fa7-brands:python", color: "#3776ab" },
	{ name: "Java", icon: "fa7-brands:java", color: "#f89820" },
	{ name: "React", icon: "fa7-brands:react", color: "#61dafb" },
	{ name: "Vue", icon: "fa7-brands:vuejs", color: "#42b883" },
	{ name: "Svelte", icon: "fa7-brands:svelte", color: "#ff3e00" },
	{ name: "Docker", icon: "fa7-brands:docker", color: "#2496ed" },
	{ name: "Linux", icon: "fa7-brands:linux", color: "#fcc624" },
	{ name: "Git", icon: "fa7-brands:git-alt", color: "#f05032" },
	{ name: "GitHub", icon: "fa7-brands:github", color: "#e6edf3" },
	{ name: "Markdown", icon: "fa7-brands:markdown", color: "#e6edf3" },
	{ name: "Figma", icon: "fa7-brands:figma", color: "#f24e1e" },
];

// 像素装饰条：固定行列，随机构造一点亮色格子
const pixelCols = 100;
const pixelRows = 5;
const pixels = Array.from({ length: pixelCols * pixelRows }, (_, index) => {
	const seed = (index * 9301 + 49297) % 233280;
	const random = seed / 233280;
	const lit = random > 0.88;
	const palette = ["#7cfc8a", "#5eead4", "#ff8ecb"];
	return {
		lit,
		color: palette[Math.floor(random * palette.length)] ?? palette[0],
		delay: `${(random * 2.4).toFixed(2)}s`,
	};
});
---

<div class="home-landing">
	<div class="home-inner">
		<header class="hero">
			<h1 class="hero-title">
				Hello I'm <span class="gradient-text">{profileConfig.name}</span>
			</h1>
			<p class="hero-line">👦 {siteConfig.title} · {siteConfig.subtitle}</p>
			<p class="hero-quote">{profileConfig.bio}</p>

			<div class="social-row">
				{
					profileConfig.links.map((link) => (
						<a
							class="social-btn"
							href={link.url}
							target={link.url.startsWith("mailto:") ? undefined : "_blank"}
							rel="noopener"
							aria-label={link.name}
							title={link.name}
						>
							<Icon name={link.icon} />
						</a>
					))
				}
			</div>

			<div class="pixel-deco" aria-hidden="true">
				{
					pixels.map((pixel) => (
						<span
							class:list={["pixel", pixel.lit && "pixel-lit"]}
							style={`--pixel-color: ${pixel.color}; --pixel-delay: ${pixel.delay};`}
						/>
					))
				}
			</div>
		</header>

		<section class="block" id="site">
			<h2 class="block-title">
				<Icon name="material-symbols:widgets-rounded" class="block-icon" />
				<span>site</span>
			</h2>
			<div class="site-grid">
				{
					siteCards.map((card) => (
						<a class="link-card site-card" href={card.href}>
							<span class="card-title">{card.title}</span>
							<span class="card-desc">{card.desc}</span>
						</a>
					))
				}
			</div>
		</section>

		<section class="block" id="project">
			<h2 class="block-title">
				<Icon name="material-symbols:deployed-code-rounded" class="block-icon" />
				<span>project</span>
			</h2>
			<div class="project-list">
				{
					projectCards.map((card) => (
						<a class="link-card project-card" href={card.href}>
							<span class="project-copy">
								<span class="card-title">{card.title}</span>
								<span class="card-desc">{card.desc}</span>
							</span>
							<Icon name={card.icon} class="project-icon" />
						</a>
					))
				}
			</div>
		</section>

		<section class="block" id="skills">
			<h2 class="block-title">
				<Icon name="material-symbols:bolt-rounded" class="block-icon" />
				<span>skills</span>
			</h2>
			<div class="skills-grid">
				{
					skills.map((skill) => (
						<span class="skill-tile" title={skill.name} aria-label={skill.name}>
							<Icon
								name={skill.icon}
								class="skill-icon"
								style={`color: ${skill.color};`}
							/>
						</span>
					))
				}
			</div>
		</section>

		<section class="block" id="friends">
			<h2 class="block-title">
				<Icon name="material-symbols:group-rounded" class="block-icon" />
				<span>Friends</span>
			</h2>
			<div class="friends-grid">
				{
					friends.length > 0 ? (
						friends.map((friend) => (
							<a
								class="friend-card"
								href={friend.siteurl}
								target="_blank"
								rel="noopener"
								title={friend.desc || friend.title}
							>
								<img
									class="friend-avatar"
									src={friend.imgurl}
									alt={friend.title}
									loading="lazy"
									referrerpolicy="no-referrer"
								/>
								<span class="friend-name">{friend.title}</span>
							</a>
						))
					) : (
						<a class="friend-card friend-empty" href="/friends/">
							<span class="friend-avatar friend-avatar-empty">+</span>
							<span class="friend-name">添加友链</span>
						</a>
					)
				}
			</div>
		</section>

		<footer class="home-footer">
			<div class="footer-line">
				&copy; {new Date().getFullYear()} {profileConfig.name} · {siteConfig.title}
			</div>
			<div class="footer-line">
				网站已运行 <span id="site-runtime">—</span>
			</div>
			<div class="footer-tags">
				{(siteConfig.keywords ?? []).map((keyword) => <span class="footer-tag">#{keyword}</span>)}
			</div>
		</footer>
	</div>
</div>

<script is:inline define:vars={{ startDate: siteConfig.siteStartDate }}>
	(function () {
		var start = new Date(startDate + "T00:00:00");
		var el = document.getElementById("site-runtime");
		if (!el || Number.isNaN(start.getTime())) return;

		function render() {
			var diff = Math.max(0, Date.now() - start.getTime());
			var days = Math.floor(diff / 86400000);
			var hours = Math.floor((diff % 86400000) / 3600000);
			var minutes = Math.floor((diff % 3600000) / 60000);
			var seconds = Math.floor((diff % 60000) / 1000);
			el.textContent = days + "天 " + hours + "小时 " + minutes + "分 " + seconds + "秒";
		}

		render();
		setInterval(render, 1000);
	})();
</script>

<style>
	.home-landing {
		position: relative;
		z-index: 1;
		min-height: 100vh;
		padding: 68px 20px 40px;
	}

	.home-inner {
		width: min(100%, 720px);
		margin: 0 auto;
	}

	.hero {
		padding: 24px 0 8px;
	}

	.hero-title {
		margin: 0 0 18px;
		color: #fff;
		font-size: clamp(2.1rem, 6.4vw, 3.7rem);
		font-weight: 900;
		line-height: 1.1;
		letter-spacing: 0.01em;
		text-shadow: 0 4px 26px rgba(0, 0, 0, 0.35);
	}

	.gradient-text {
		background: linear-gradient(
			96deg,
			#ff8ecb 0%,
			#c98bff 38%,
			#7cc7ff 68%,
			#ffd38a 100%
		);
		background-size: 220% auto;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: gradientShift 8s ease-in-out infinite;
	}

	.hero-line {
		margin: 0 0 10px;
		color: #fff;
		font-size: 1.1rem;
		font-weight: 700;
		text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
	}

	.hero-quote {
		margin: 0;
		color: rgba(255, 255, 255, 0.88);
		font-size: 1.05rem;
		text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
	}

	.social-row {
		display: flex;
		gap: 14px;
		margin-top: 22px;
	}

	.social-btn {
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.18);
		border: 1px solid rgba(255, 255, 255, 0.26);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		color: #fff;
		font-size: 1.4rem;
		transition: background-color 0.25s ease, transform 0.25s ease;
	}

	.social-btn:hover {
		background: rgba(255, 255, 255, 0.32);
		transform: translateY(-4px);
	}

	/* 像素装饰条 */
	.pixel-deco {
		display: grid;
		grid-template-columns: repeat(100, 1fr);
		gap: 2px;
		margin: 32px 0 6px;
		padding: 10px;
		border-radius: 10px;
		background: rgba(10, 16, 26, 0.24);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.pixel {
		aspect-ratio: 1;
		border-radius: 1px;
		background: rgba(255, 255, 255, 0.62);
	}

	.pixel-lit {
		background: var(--pixel-color);
		animation: pixelPulse 2.4s ease-in-out infinite;
		animation-delay: var(--pixel-delay);
	}

	/* 区块 */
	.block {
		margin-top: 44px;
	}

	.block-title {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 14px;
		color: #fff;
		font-size: 1.5rem;
		font-weight: 800;
		line-height: 1;
		text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
	}

	.block-icon {
		font-size: 1.15rem;
		opacity: 0.92;
	}

	/* site / project 卡片 */
	.site-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px;
	}

	.project-list {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.link-card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 16px 18px;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.42);
		border: 1px solid rgba(255, 255, 255, 0.24);
		backdrop-filter: blur(20px) saturate(150%);
		-webkit-backdrop-filter: blur(20px) saturate(150%);
		color: #1b2230;
		transition: transform 0.3s ease, background-color 0.25s ease;
	}

	.link-card:hover {
		transform: translateY(-3px);
		background: rgba(255, 255, 255, 0.58);
	}

	.site-card {
		min-height: 96px;
		justify-content: center;
	}

	.project-card {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		min-height: 104px;
	}

	.project-copy {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.project-icon {
		flex: none;
		font-size: 2rem;
		color: rgba(27, 34, 48, 0.68);
	}

	.card-title {
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.card-desc {
		color: rgba(27, 34, 48, 0.55);
		font-size: 0.82rem;
		line-height: 1.4;
	}

	/* skills */
	.skills-grid {
		display: grid;
		grid-template-columns: repeat(8, minmax(0, 1fr));
		gap: 10px;
	}

	.skill-tile {
		display: grid;
		place-items: center;
		aspect-ratio: 1;
		border-radius: 12px;
		background: rgba(18, 24, 36, 0.55);
		border: 1px solid rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		transition: transform 0.25s ease, background-color 0.25s ease;
	}

	.skill-tile:hover {
		transform: translateY(-4px) scale(1.05);
		background: rgba(18, 24, 36, 0.72);
	}

	.skill-icon {
		font-size: 1.6rem;
	}

	/* Friends */
	.friends-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 14px;
	}

	.friend-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 16px 8px;
		min-height: 118px;
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.42);
		border: 1px solid rgba(255, 255, 255, 0.24);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		transition: transform 0.25s ease, background-color 0.25s ease;
	}

	.friend-card:hover {
		transform: translateY(-4px);
		background: rgba(255, 255, 255, 0.58);
	}

	.friend-avatar {
		width: 54px;
		height: 54px;
		border-radius: 50%;
		object-fit: cover;
		background: rgba(255, 255, 255, 0.6);
	}

	.friend-avatar-empty {
		display: grid;
		place-items: center;
		color: #1b2230;
		font-size: 1.5rem;
		font-weight: 300;
	}

	.friend-name {
		color: #1b2230;
		font-size: 0.8rem;
		font-weight: 600;
		text-align: center;
		line-height: 1.3;
	}

	/* 页脚 */
	.home-footer {
		margin-top: 56px;
		padding: 26px 12px 8px;
		border-top: 1px dashed rgba(255, 255, 255, 0.28);
		text-align: center;
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.82rem;
	}

	.footer-line {
		margin-bottom: 8px;
	}

	.footer-tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		margin-top: 12px;
	}

	.footer-tag {
		padding: 3px 10px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.16);
		color: rgba(255, 255, 255, 0.85);
		font-size: 0.75rem;
	}

	/* 暗色模式 */
	:global(:root.dark) .link-card,
	:global(:root.dark) .friend-card {
		background: rgba(18, 23, 34, 0.5);
		border-color: rgba(255, 255, 255, 0.14);
		color: #eef2ff;
	}

	:global(:root.dark) .link-card:hover,
	:global(:root.dark) .friend-card:hover {
		background: rgba(18, 23, 34, 0.68);
	}

	:global(:root.dark) .card-desc {
		color: rgba(238, 242, 255, 0.6);
	}

	:global(:root.dark) .project-icon {
		color: rgba(238, 242, 255, 0.7);
	}

	:global(:root.dark) .friend-name,
	:global(:root.dark) .friend-avatar-empty {
		color: #eef2ff;
	}

	/* 移动端 */
	@media (max-width: 767px) {
		.home-landing {
			padding: 48px 14px 32px;
		}

		.pixel-deco {
			gap: 3px;
			padding: 8px;
		}

		.site-grid {
			grid-template-columns: 1fr;
		}

		.skills-grid {
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}

		.friends-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.friend-card {
			min-height: 104px;
		}
	}

	@keyframes gradientShift {
		0%,
		100% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
	}

	@keyframes pixelPulse {
		0%,
		100% {
			opacity: 0.35;
			transform: scale(0.92);
		}
		50% {
			opacity: 1;
			transform: scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gradient-text,
		.pixel-lit {
			animation: none;
		}
	}
</style>
